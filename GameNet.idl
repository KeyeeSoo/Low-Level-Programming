/* This replaces the old movement-only messages with game-specific DDS topics.
   Generate: idlc -l c GameNet.idl (creates GameNet.h and GameNet.c). */
struct PotionJoin {
    long token;
};
struct PotionWelcome {
    long token;
    long player;
};
struct PotionCommand {
    long token;
    long player;
    long action;
    long dx;
    long dy;
    long session;
};
struct PotionSnapshot {
    long revision;
    long joined1;
    long joined2;
    long p1x;
    long p1y;
    long p2x;
    long p2y;
    long held1;
    long held2;
    long next_ingredient;
    long phase;
    long active_player;
    long rune_mistakes;
    long session;
};
