// Based on the original DDS messages.idl.
// After editing, always regenerate messages.c and messages.h with: idlc -l c messages.idl

struct JoinRequest
{
    boolean b_dummy;
    long int_client_token; // Identify a client so repeated join requests reuse the same ID
};

struct JoinResponse
{
    long int_player_id;
    long int_client_token;
};

struct Input
{
    long int_player_id;
    char ch_direction;
    long int_client_token;
};

struct Position
{
    long int_player_id;
    long int_x;
    long int_y;
};

// E to pick up/add, Q to drop, and results of the local mouse tracing.
struct GameAction
{
    long int_player_id;
    long int_client_token;
    long int_action;
    long int_session;
};

// Shared authoritative state sent by the server to both clients.
struct GameState
{
    long int_phase;
    long int_stage;
    long int_actor;
    long int_mistakes;
    long int_held1;
    long int_held2;
    long int_session;
    long int_revision;
    long int_num_players;
    // Recipe order is generated only by the server, never by clients.
    long int_round;
    long int_recipes_completed;
    long int_used_mask;
    long int_recipe_length;
    long int_recipe0;
    long int_recipe1;
    long int_recipe2;
    long int_recipe3;
    // Server-provided countdown, in milliseconds. 0 while waiting/finished.
    long int_timer_remaining_ms;
    long int_timer_limit_ms;
};
