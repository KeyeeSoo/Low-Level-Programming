// Based on the original DDS messages.idl.
// After editing, always regenerate messages.c and messages.h with: idlc -l c messages.idl

// Login happens before joining. Both sides run with DDS Security encryption, so
// the password is never readable on the network. The server only stores a hash.
struct AuthRequest
{
    long int_nonce;  // Random per attempt: matches the response, makes retries safe
    long int_mode;   // AUTH_MODE_LOGIN, AUTH_MODE_REGISTER or AUTH_MODE_GUEST
    string<16> str_username;
    string<32> str_password;
};

struct AuthResponse
{
    long int_nonce;
    long int_result;         // AUTH_OK or the reason it failed
    long int_session_token;  // Server-issued, proves identity from here on
    string<16> str_username;
};

// A player's message to the server, which verifies the sender before relaying it.
struct ChatSend
{
    long int_player_id;
    long int_client_token;
    string<80> str_text;
};

// The relayed message. The name comes from the server, so it can't be forged.
struct ChatMessage
{
    long int_sequence;
    long int_player_id;
    string<16> str_username;
    string<80> str_text;
};

struct JoinRequest
{
    boolean b_dummy;
    long int_client_token; // The session token issued at login
};

struct JoinResponse
{
    long int_player_id;
    long int_client_token;
};

struct Input
{
    long int_player_id;
    char ch_direction;
    long int_client_token;
};

struct Position
{
    long int_player_id;
    long int_x;
    long int_y;
};

// Gameplay actions, plus ACTION_LEAVE and ACTION_HEARTBEAT controls.
// JoinResponse player_id=-1 acknowledges ACTION_LEAVE for that client token.
struct GameAction
{
    long int_player_id;
    long int_client_token;
    long int_action;
    long int_session;
};

// Shared authoritative state sent by the server to both clients.
struct GameState
{
    long int_phase;
    long int_stage;
    long int_actor;
    long int_mistakes;
    long int_held1;
    long int_held2;
    long int_session;
    long int_revision;
    long int_num_players;
    // Recipe order is generated only by the server, never by clients.
    long int_round;
    long int_recipes_completed;
    long int_used_mask;
    long int_recipe_length;
    long int_recipe0;
    long int_recipe1;
    long int_recipe2;
    long int_recipe3;
    // Server-provided countdown, in milliseconds. 0 while waiting/finished.
    long int_timer_remaining_ms;
    long int_timer_limit_ms;
    // Verified account names, empty until that player has joined.
    string<16> str_name1;
    string<16> str_name2;
    // While paused: the player ID whose seat is saved for them to rejoin,
    // or 0 when the player who left was a guest (who can't rejoin).
    long int_away_player;
};
