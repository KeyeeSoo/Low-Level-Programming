<?xml version="1.0" encoding="UTF-8"?>
<dds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:noNamespaceSchemaLocation="http://www.omg.org/spec/DDS-SECURITY/20170901/omg_shared_ca_permissions.xsd">
  <permissions>
    <grant name="ServerGrant">
      <subject_name>CN=Gingerbread Server,O=CSD3116 Team A1,C=SG</subject_name>
      <validity><not_before>2020-01-01T00:00:00</not_before><not_after>2040-01-01T00:00:00</not_after></validity>
      <allow_rule>
        <domains><id_range><min>0</min><max>230</max></id_range></domains>
        <publish><topics><topic>AuthResponse</topic><topic>JoinResponse</topic><topic>Position</topic><topic>GameState</topic><topic>ChatMessage</topic></topics></publish>
        <subscribe><topics><topic>AuthRequest</topic><topic>JoinRequest</topic><topic>Input</topic><topic>GameAction</topic><topic>ChatSend</topic></topics></subscribe>
      </allow_rule>
      <default>DENY</default>
    </grant>
    <grant name="ClientGrant">
      <subject_name>CN=Gingerbread Client,O=CSD3116 Team A1,C=SG</subject_name>
      <validity><not_before>2020-01-01T00:00:00</not_before><not_after>2040-01-01T00:00:00</not_after></validity>
      <allow_rule>
        <domains><id_range><min>0</min><max>230</max></id_range></domains>
        <publish><topics><topic>AuthRequest</topic><topic>JoinRequest</topic><topic>Input</topic><topic>GameAction</topic><topic>ChatSend</topic></topics></publish>
        <subscribe><topics><topic>AuthResponse</topic><topic>JoinResponse</topic><topic>Position</topic><topic>GameState</topic><topic>ChatMessage</topic></topics></subscribe>
      </allow_rule>
      <default>DENY</default>
    </grant>
  </permissions>
</dds>
